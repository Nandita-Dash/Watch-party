PORT=4000

# Required in production — the server refuses to boot without it.
JWT_SECRET=change-me-in-production

# Only needed when the client is hosted on a DIFFERENT origin than this server.
# In the default single-service deployment the server serves the built client
# itself, so this stays unset and CORS is off entirely.
# CLIENT_ORIGIN=http://localhost:5173

# Override where the built client is read from. Defaults to ../client/dist.
# CLIENT_DIST_DIR=
